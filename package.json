{
  "name": "lagermat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:hosted": "node scripts/build-netlify.mjs",
    "lint:workflows": "bash scripts/actionlint.sh",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "recipes:seed": "node scripts/extract-demo-recipes.mjs",
    "recipes:seed:check": "node scripts/extract-demo-recipes.mjs --check",
    "bootstrap:hosted": "node scripts/bootstrap-hosted.mjs",
    "check:deployment": "node scripts/verify-deployment-config.mjs --hosted && node scripts/check-repository-secrets.mjs",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "supabase:start": "bash scripts/start-local-stack.sh",
    "supabase:stop": "bash scripts/supabase-local.sh stop",
    "supabase:status": "bash scripts/supabase-local.sh status",
    "supabase:reset": "bash scripts/supabase-local.sh db reset",
    "supabase:test": "bash scripts/supabase-local.sh test db",
    "supabase:lint": "bash scripts/supabase-local.sh db lint --level warning --schema public --local",
    "supabase:types": "bash scripts/supabase-local.sh gen types typescript --local"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/libre-franklin": "^5.2.8",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
