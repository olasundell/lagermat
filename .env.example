# Local development defaults. Netlify supplies hosted values per site.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# This is the Supabase CLI's public local-development key, never a server or
# service-role secret. Hosted sites receive their own publishable key in Netlify.
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Anonymous demo is opt-in per environment. The site key is public; its
# matching secret belongs in Supabase/Netlify server configuration only.
VITE_DEMO_MODE=false
# VITE_TURNSTILE_SITE_KEY=

# Supplier-product semantic reranking is server-only. Netlify AI Gateway
# supplies OPENAI_BASE_URL and OPENAI_API_KEY to the function when the gateway
# is enabled for a hosted site. Never add either value with a VITE_ prefix.
# Without the gateway, local Supabase development uses a clearly labelled
# deterministic fixture adapter; hosted environments remain deterministic-only.

# Scoutnet source references use a stable server-side HMAC secret. Local
# Supabase wrapper scripts provide a clearly synthetic default. A private
# hosted environment must inject its own value without a VITE_ prefix.
# SCOUTNET_SOURCE_REFERENCE_SECRET=
# Reconciliation fixture mode is local-only and is supplied by the wrapper
# scripts. Never configure SCOUTNET_RECONCILIATION_MODE in a hosted environment.
